[Unit]
Description=finnspark Backend — Accelerator & Investment Platform (FastAPI/uvicorn)
After=network.target

[Service]
User=administrator
WorkingDirectory=/home/administrator/finnspark/backend
ExecStart=/usr/bin/python3 run.py
Environment=PORT=8002
Environment=PUBLIC_BASE_URL=https://accelerate.finnpact.com
Environment=DATABASE_URL=sqlite:////home/administrator/finnspark/backend/finnspark.db
# JWT_SECRET and SMTP/Graph credentials load from backend/.env via config.py (dotenv)
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
